{
  "expo": {
    "name": "M-Pesa POS",
    "slug": "merchant-pos-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-logo.png",
    "scheme": "merchantposapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-logo.png",
      "infoPlist": {
        "UIDeviceFamily": [
          1,
          2
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E0001B",
        "foregroundImage": "./assets/images/app-logo.png",
        "backgroundImage": "./assets/images/app-logo.png",
        "monochromeImage": "./assets/images/app-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_PRIVILEGED_PHONE_STATE",
        "android.permission.READ_SERIAL"
      ],
      "package": "com.devlereko.merchantposapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./assets/images/app-logo.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "permissions": [
              "android.permission.READ_PHONE_STATE",
              "android.permission.READ_PRIVILEGED_PHONE_STATE",
              "android.permission.READ_SERIAL"
            ],
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9facc62f-272b-4dd0-a717-c6ad0d7189c4",
         "apiUrl": "https://api.example.com",
         "printerCharacteristicUUID": "YOUR_UUID_HERE",
         "printerServiceUUID": "YOUR_UUID_HERE"
      }
    },
    "owner": "dahbush"
  }
}
